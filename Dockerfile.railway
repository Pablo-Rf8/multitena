FROM php:8.4-apache-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends unzip supervisor libsqlite3-dev \
    && docker-php-ext-install pdo_sqlite \
    && a2enmod rewrite headers \
    && a2dismod -f mpm_event mpm_worker \
    && a2enmod -f mpm_prefork \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
WORKDIR /app/backend
COPY backend/composer.json backend/composer.lock ./
RUN composer install --no-dev --no-scripts --no-progress --prefer-dist --no-interaction
COPY backend/ ./
COPY frontend/ /app/frontend/
COPY docker/apache.railway.conf /etc/apache2/sites-available/000-default.conf
COPY docker/supervisor.railway.conf /etc/supervisor/conf.d/multitena.conf
COPY docker/railway-start.sh /usr/local/bin/multitena-railway-start
RUN cp .env.example .env \
    && sed -i 's/\r$//' /usr/local/bin/multitena-railway-start \
    && sed -i 's/Listen 80/Listen 8080/' /etc/apache2/ports.conf \
    && apache2ctl -t \
    && composer dump-autoload --no-dev --optimize \
    && chmod +x /usr/local/bin/multitena-railway-start \
    && mkdir -p /app/bd /app/backend/storage/framework/cache /app/backend/storage/framework/sessions /app/backend/storage/framework/views \
    && chown -R www-data:www-data /app/bd /app/backend/storage /app/backend/bootstrap/cache

EXPOSE 8080
CMD ["/usr/local/bin/multitena-railway-start"]
