FROM php:8.4-fpm-bookworm AS app
RUN apt-get update && apt-get install -y --no-install-recommends unzip libsqlite3-dev \
    && docker-php-ext-install pdo_sqlite \
    && rm -rf /var/lib/apt/lists/*
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
WORKDIR /app/backend
COPY backend/composer.json backend/composer.lock ./
RUN composer install --no-dev --no-scripts --no-progress --prefer-dist --no-interaction
COPY backend/ ./
COPY frontend/ /app/frontend/
RUN composer dump-autoload --no-dev --optimize \
    && mkdir -p /app/bd /app/backups \
    && chown -R www-data:www-data /app/bd /app/backups /app/backend/storage /app/backend/bootstrap/cache
USER www-data
CMD ["php-fpm"]

FROM nginx:1.27-alpine AS web
COPY docker/nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY backend/public/ /app/backend/public/
